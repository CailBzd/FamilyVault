# Stripe Configuration - PRODUCTION Environment (à utiliser en production)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Product IDs - Plans Mensuels
STRIPE_PERSONAL_MONTHLY_PRICE_ID=price_...
STRIPE_FAMILY_MONTHLY_PRICE_ID=price_...
STRIPE_CLAN_MONTHLY_PRICE_ID=price_...
STRIPE_LEGACY_MONTHLY_PRICE_ID=price_...

# Stripe Product IDs - Plans Annuels (avec réduction)
STRIPE_PERSONAL_YEARLY_PRICE_ID=price_...
STRIPE_FAMILY_YEARLY_PRICE_ID=price_...
STRIPE_CLAN_YEARLY_PRICE_ID=price_...
STRIPE_LEGACY_YEARLY_PRICE_ID=price_...

# Google AdSense Configuration (pour le plan gratuit)
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-your-adsense-id
NEXT_PUBLIC_GOOGLE_ADSENSE_ENABLED=true

# Email Configuration (pour les notifications et vérifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password

# SMS Configuration (pour la vérification par SMS)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+33123456789

# Security
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Database pour l'arbre généalogique et les connexions
DATABASE_URL=your-database-url 