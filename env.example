# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FamilyVault
NODE_ENV=development

# Stripe Configuration - TEST Environment
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51RTSYyRPhxbsp52qErzCWC2uhAacBtf4rOYpE8a7h7TvgFe0IBVbkgp04Ty6H4tZzM4Lj0RqJZLarqYZ5BUnhBq000wSxaQ3jv
STRIPE_SECRET_KEY=sk_test_51RTSYyRPhxbsp52q
